{
  "name": "@pi-managed/web-console",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pi Managed Backend — web console. Vite + React SPA served by the backend at /console (tmp/console-spec.md).",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-budget.mjs",
